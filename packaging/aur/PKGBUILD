pkgname=codex-id-lab-unofficial-bin
pkgver=26.908.40834
pkgrel=2
pkgdesc="Codex I+D Lab - Unofficial"
arch=('x86_64')
url="https://github.com/0xCyberBerserker/codex-id-lab-unofficial"
license=('custom')
options=('!strip' '!debug')
provides=('codex-id-lab-unofficial' 'codex-ui-linux-port')
conflicts=('codex-id-lab-unofficial' 'codex-ui-linux-port')
replaces=('codex-ui-linux-port')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'cups' 'dbus' 'expat' 'gcc-libs' 'gdk-pixbuf2' 'glib2' 'gtk3' 'libdrm' 'libnotify' 'libusb' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'mesa' 'nspr' 'nss' 'pango' 'systemd-libs' 'xdg-utils' 'nodejs' 'curl' 'jq' 'github-cli' 'desktop-file-utils')
optdepends=('pyside6: native Qt companion' 'spectacle: OCR and QR capture' 'tesseract: OCR' 'tesseract-data-eng: English OCR' 'tesseract-data-spa: Spanish OCR' 'zbar: QR decoding')
source=("${pkgname}-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst::https://github.com/0xCyberBerserker/codex-id-lab-unofficial/releases/download/v${pkgver}-${pkgrel}/codex-id-lab-unofficial-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst")
sha256sums=('77783bc0f1bf622b1544b3414054b22a21db433af394a0978c97fe5c71dc86b8')

prepare() {
  local archive="${srcdir}/${pkgname}-${pkgver}-${pkgrel}-x86_64.pkg.tar.zst"
  gh attestation verify "$archive" \
    --repo 0xCyberBerserker/codex-id-lab-unofficial \
    --signer-workflow 0xCyberBerserker/codex-id-lab-unofficial/.github/workflows/release.yml \
    --source-ref refs/heads/main \
    --deny-self-hosted-runners
}

package() {
  cp -a "${srcdir}/opt" "${pkgdir}/"
  cp -a "${srcdir}/usr" "${pkgdir}/"
}
