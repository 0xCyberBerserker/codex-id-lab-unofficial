Name: codex-id-lab-unofficial
Version: @VERSION@
Release: 1
Summary: Codex I+D Lab - Unofficial
License: Custom
BuildArch: x86_64
Provides: codex-ui-linux-port
Obsoletes: codex-ui-linux-port
Requires: nodejs
Requires: curl
Requires: jq
Requires: desktop-file-utils
Requires: alsa-lib
Requires: at-spi2-core
Requires: cairo
Requires: cups-libs
Requires: dbus-libs
Requires: expat
Requires: gtk3
Requires: libdrm
Requires: libnotify
Requires: libusb1
Requires: libX11
Requires: libxcb
Requires: libXcomposite
Requires: libXdamage
Requires: libXext
Requires: libXfixes
Requires: libxkbcommon
Requires: libXrandr
