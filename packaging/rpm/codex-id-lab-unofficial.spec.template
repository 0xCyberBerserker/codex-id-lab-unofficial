%description
Unofficial packaging automation for the official ChatGPT Linux runtime.

%prep

%build

%install
mkdir -p %{buildroot}
tar -xf %{_sourcedir}/codex-id-lab-unofficial-%{version}-payload.tar -C %{buildroot}

%files
