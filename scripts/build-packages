#!/usr/bin/env bash
set -euo pipefail

PKGROOT="${1:?pkgroot required}"
VERSION="${2:?version required}"
SOURCE_SHA="${3:?source archive sha required}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIST="$ROOT/dist"
NAME="codex-ui-linux-port"
ARCH="x86_64"

rm -rf "$DIST"
mkdir -p "$DIST"

stage_common() {
  local target="$1"
  mkdir -p "$target/opt" "$target/usr/bin" "$target/usr/lib/systemd/user" "$target/usr/share/applications" "$target/usr/share/icons/hicolor/scalable/apps" "$target/usr/share/licenses/codex-ui-linux-port"
  cp -a "$PKGROOT/opt/codex-ui-linux-port" "$target/opt/"
  install -m 755 "$ROOT/scripts/codex-ui-update" "$target/opt/codex-ui-linux-port/bin/codex-ui-update"
  ln -s codex-ui-update "$target/opt/codex-ui-linux-port/bin/codexui-update"
  ln -s /opt/codex-ui-linux-port/bin/codex-ui-linux "$target/usr/bin/codex-ui-linux"
  ln -s /opt/codex-ui-linux-port/bin/codex-ui-update "$target/usr/bin/codex-ui-update"
  ln -s /opt/codex-ui-linux-port/bin/codexui-update "$target/usr/bin/codexui-update"
  ln -s /opt/codex-ui-linux-port/bin/codex-ui-tools "$target/usr/bin/codex-ui-tools"
  install -m 644 "$PKGROOT/opt/codex-ui-linux-port/share/codex-ui-linux.desktop" "$target/usr/share/applications/codex-ui-linux.desktop"
  install -m 644 "$PKGROOT/opt/codex-ui-linux-port/share/codex-ui-tools.desktop" "$target/usr/share/applications/codex-ui-tools.desktop"
  install -m 644 "$PKGROOT/opt/codex-ui-linux-port/share/systemd/user/codex-ui-companion.service" "$target/usr/lib/systemd/user/codex-ui-companion.service"
  if [[ -f "$PKGROOT/opt/codex-ui-linux-port/share/icons/hicolor/scalable/apps/codex-ui-linux.svg" ]]; then
    install -m 644 "$PKGROOT/opt/codex-ui-linux-port/share/icons/hicolor/scalable/apps/codex-ui-linux.svg" "$target/usr/share/icons/hicolor/scalable/apps/codex-ui-linux.svg"
  fi
  install -m 644 "$ROOT/LICENSE" "$target/usr/share/licenses/codex-ui-linux-port/LICENSE"
  install -m 644 "$ROOT/NOTICE.md" "$target/usr/share/licenses/codex-ui-linux-port/NOTICE.md"
  install -m 644 "$ROOT/DISCLAIMER.md" "$target/usr/share/licenses/codex-ui-linux-port/DISCLAIMER.md"
  cat > "$target/opt/codex-ui-linux-port/manifest.json" <<JSON
{"version":"$VERSION","sourceArchiveSha256":"$SOURCE_SHA","package":"$NAME"}
JSON
}

arch_root="$DIST/arch-root"
stage_common "$arch_root"
cat > "$DIST/.PKGINFO" <<EOF
pkgname = $NAME
pkgbase = $NAME
pkgver = $VERSION-1
pkgdesc = Unofficial Codex UI Linux port
url = https://github.com/0xCyberBerserker/codex-ui-linux-port
builddate = $(date +%s)
packager = unofficial automation
size = $(du -sb "$arch_root" | awk '{print $1}')
arch = $ARCH
license = custom
depend = nodejs
depend = curl
depend = jq
depend = desktop-file-utils
depend = alsa-lib
depend = at-spi2-core
depend = cairo
depend = cups
depend = dbus
depend = expat
depend = gcc-libs
depend = gdk-pixbuf2
depend = glib2
depend = gtk3
depend = libdrm
depend = libnotify
depend = libusb
depend = libx11
depend = libxcb
depend = libxcomposite
depend = libxdamage
depend = libxext
depend = libxfixes
depend = libxkbcommon
depend = libxrandr
depend = mesa
depend = nspr
depend = nss
depend = pango
depend = systemd-libs
depend = xdg-utils
depend = pyside6
depend = spectacle
depend = tesseract
depend = tesseract-data-eng
depend = tesseract-data-spa
depend = zbar
EOF
cp "$DIST/.PKGINFO" "$arch_root/.PKGINFO"
(cd "$arch_root" && bsdtar --zstd -cf "$DIST/${NAME}-${VERSION}-1-${ARCH}.pkg.tar.zst" .PKGINFO opt usr)
rm -rf "$arch_root"

deb_root="$DIST/deb-root"
if command -v dpkg-deb >/dev/null 2>&1; then
  stage_common "$deb_root"
  mkdir -p "$deb_root/DEBIAN"
  cat > "$deb_root/DEBIAN/control" <<EOF
Package: $NAME
Version: $VERSION
Section: devel
Priority: optional
Architecture: amd64
Depends: libgtk-3-0, libnotify4, libnss3, xdg-utils, libatspi2.0-0, libdrm2, libgbm1, libxcb-dri3-0, libasound2, libcups2, libdbus-1-3, libx11-6, libx11-xcb1, libxcb1, libxcomposite1, libxdamage1, libxext6, libxfixes3, libxkbcommon0, libxrandr2, mesa-vulkan-drivers | vulkan-icd, nodejs, curl, jq, desktop-file-utils, python3-pyside6.qtwidgets, python3-pyside6.qtnetwork, kde-spectacle, tesseract-ocr, tesseract-ocr-eng, tesseract-ocr-spa, zbar-tools
Maintainer: unofficial automation
Description: Unofficial Codex UI Linux port
 Unofficial packaging automation for Codex UI.
EOF
  dpkg-deb --build "$deb_root" "$DIST/${NAME}_${VERSION}_amd64.deb" >/dev/null
  rm -rf "$deb_root"
else
  echo "build-packages: dpkg-deb not found; deb package skipped" >&2
fi

rpm_root="$DIST/rpm-root"
if command -v rpmbuild >/dev/null 2>&1; then
  stage_common "$rpm_root"
  tar -C "$rpm_root" -cf "$DIST/${NAME}-${VERSION}-payload.tar" .
  rm -rf "$rpm_root"
  cat > "$DIST/${NAME}.spec" <<EOF
%global __brp_strip_static_archive %{nil}
Name: $NAME
Version: $VERSION
Release: 1
Summary: Unofficial Codex UI Linux port
License: Custom
BuildArch: x86_64
Requires: nodejs
Requires: curl
Requires: jq
Requires: desktop-file-utils
Requires: alsa-lib
Requires: at-spi2-core
Requires: cairo
Requires: cups-libs
Requires: dbus-libs
Requires: expat
Requires: gtk3
Requires: libdrm
Requires: libnotify
Requires: libusb1
Requires: libX11
Requires: libxcb
Requires: libXcomposite
Requires: libXdamage
Requires: libXext
Requires: libXfixes
Requires: libxkbcommon
Requires: libXrandr
Requires: mesa-libgbm
Requires: nspr
Requires: nss
Requires: pango
Requires: xdg-utils
Requires: python3-pyside6
Requires: spectacle
Requires: tesseract
Requires: tesseract-langpack-eng
Requires: tesseract-langpack-spa
Requires: zbar

%description
Unofficial packaging automation for Codex UI.

%prep

%build

%install
mkdir -p %{buildroot}
tar -xf %{_sourcedir}/${NAME}-${VERSION}-payload.tar -C %{buildroot}

%files
/opt/codex-ui-linux-port
/usr/bin/codex-ui-linux
/usr/bin/codex-ui-update
/usr/bin/codexui-update
/usr/bin/codex-ui-tools
/usr/lib/systemd/user/codex-ui-companion.service
/usr/share/applications/codex-ui-linux.desktop
/usr/share/applications/codex-ui-tools.desktop
/usr/share/icons/hicolor/scalable/apps/codex-ui-linux.svg
/usr/share/licenses/codex-ui-linux-port
EOF

  rpmbuild --define "_topdir $DIST/rpmbuild" \
    --define "_sourcedir $DIST" \
    --define "_rpmdir $DIST" \
    --define "_binary_payload w7T0.zstdio" \
    -bb "$DIST/${NAME}.spec" >/dev/null
  built_rpm="$(find "$DIST/$ARCH" -name '*.rpm' -type f -print -quit)"
  [[ -n "$built_rpm" ]] || { echo "build-packages: RPM output not found" >&2; exit 1; }
  cp "$built_rpm" "$DIST/${NAME}-${VERSION}-1.x86_64.rpm"
else
  echo "build-packages: rpmbuild not found; rpm package skipped" >&2
fi

rm -rf "$DIST/arch-root" "$DIST/deb-root" "$DIST/rpm-root" "$DIST/rpmbuild" "$DIST/x86_64"
rm -f "$DIST/.PKGINFO" "$DIST/${NAME}.spec" "$DIST/${NAME}-${VERSION}-payload.tar"
