#!/usr/bin/env bash
set -euo pipefail

PKGROOT="${1:?pkgroot required}"
VERSION="${2:?version required}"
REVISION="${3:?packaging revision required}"
MANIFEST="${4:?manifest required}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DIST="${CODEX_LAB_DIST:-$ROOT/dist}"
NAME="codex-id-lab-unofficial"
ARCH="x86_64"

[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "build-packages: invalid upstream version" >&2; exit 2; }
[[ "$REVISION" =~ ^[1-9][0-9]*$ ]] || { echo "build-packages: invalid packaging revision" >&2; exit 2; }
[[ -s "$MANIFEST" ]] || { echo "build-packages: manifest not found" >&2; exit 2; }

rm -rf "$DIST"
mkdir -p "$DIST"

stage_common() {
  local target="$1"
  mkdir -p "$target/opt" "$target/usr/bin" "$target/usr/lib/systemd/user" "$target/usr/share/applications" "$target/usr/share/icons/hicolor/scalable/apps" "$target/usr/share/licenses/codex-id-lab-unofficial"
  cp -a "$PKGROOT/opt/codex-id-lab-unofficial" "$target/opt/"
  install -m 755 "$ROOT/scripts/codex-lab-install" "$target/opt/codex-id-lab-unofficial/bin/codex-lab-install"
  ln -sf codex-lab-install "$target/opt/codex-id-lab-unofficial/bin/codex-lab-update"
  ln -s /opt/codex-id-lab-unofficial/bin/codex-lab "$target/usr/bin/codex-lab"
  ln -s /opt/codex-id-lab-unofficial/bin/codex-lab-install "$target/usr/bin/codex-lab-install"
  ln -s /opt/codex-id-lab-unofficial/bin/codex-lab-update "$target/usr/bin/codex-lab-update"
  ln -s /opt/codex-id-lab-unofficial/bin/codex-lab-tools "$target/usr/bin/codex-lab-tools"
  install -m 644 "$PKGROOT/opt/codex-id-lab-unofficial/share/codex-lab.desktop" "$target/usr/share/applications/codex-lab.desktop"
  install -m 644 "$PKGROOT/opt/codex-id-lab-unofficial/share/codex-lab-tools.desktop" "$target/usr/share/applications/codex-lab-tools.desktop"
  install -m 644 "$PKGROOT/opt/codex-id-lab-unofficial/share/systemd/user/codex-lab-companion.service" "$target/usr/lib/systemd/user/codex-lab-companion.service"
  if [[ -f "$PKGROOT/opt/codex-id-lab-unofficial/share/icons/hicolor/scalable/apps/codex-lab.svg" ]]; then
    install -m 644 "$PKGROOT/opt/codex-id-lab-unofficial/share/icons/hicolor/scalable/apps/codex-lab.svg" "$target/usr/share/icons/hicolor/scalable/apps/codex-lab.svg"
  fi
  install -m 644 "$ROOT/LICENSE" "$target/usr/share/licenses/codex-id-lab-unofficial/LICENSE"
  install -m 644 "$ROOT/NOTICE.md" "$target/usr/share/licenses/codex-id-lab-unofficial/NOTICE.md"
  install -m 644 "$ROOT/DISCLAIMER.md" "$target/usr/share/licenses/codex-id-lab-unofficial/DISCLAIMER.md"
  mkdir -p "$target/usr/share/licenses/codex-id-lab-unofficial/third-party/ilysenko"
  install -m 644 "$ROOT/third-party/ilysenko/LICENSE" "$target/usr/share/licenses/codex-id-lab-unofficial/third-party/ilysenko/LICENSE"
  install -m 644 "$ROOT/third-party/upstream.lock.json" "$target/usr/share/licenses/codex-id-lab-unofficial/third-party/upstream.lock.json"
  install -m 644 "$MANIFEST" "$target/opt/codex-id-lab-unofficial/manifest.json"
}

arch_root="$DIST/arch-root"
stage_common "$arch_root"
cat > "$DIST/.PKGINFO" <<EOF
pkgname = $NAME
pkgbase = $NAME
pkgver = $VERSION-$REVISION
pkgdesc = Codex I+D Lab - Unofficial
url = https://github.com/0xCyberBerserker/codex-id-lab-unofficial
builddate = $(date +%s)
packager = unofficial automation
size = $(du -sb "$arch_root" | awk '{print $1}')
arch = $ARCH
license = custom
provides = codex-ui-linux-port
conflict = codex-ui-linux-port
replaces = codex-ui-linux-port
depend = nodejs
depend = curl
depend = jq
depend = github-cli
depend = desktop-file-utils
depend = alsa-lib
depend = at-spi2-core
depend = cairo
depend = cups
depend = dbus
depend = expat
depend = gcc-libs
depend = gdk-pixbuf2
depend = glib2
depend = gtk3
depend = libdrm
depend = libnotify
depend = libusb
depend = libx11
depend = libxcb
depend = libxcomposite
depend = libxdamage
depend = libxext
depend = libxfixes
depend = libxkbcommon
depend = libxrandr
depend = mesa
depend = nspr
depend = nss
depend = pango
depend = systemd-libs
depend = xdg-utils
optdepend = pyside6: native Qt companion
optdepend = python-websockets>=15: experimental shared-authority companion bridge
optdepend = spectacle: interactive OCR and QR capture
optdepend = tesseract: optional OCR
optdepend = tesseract-data-eng: English OCR
optdepend = tesseract-data-spa: Spanish OCR
optdepend = zbar: optional QR decoding
EOF
cp "$DIST/.PKGINFO" "$arch_root/.PKGINFO"
(cd "$arch_root" && bsdtar --uid 0 --gid 0 --uname root --gname root --zstd -cf "$DIST/${NAME}-${VERSION}-${REVISION}-${ARCH}.pkg.tar.zst" .PKGINFO opt usr)
rm -rf "$arch_root"

deb_root="$DIST/deb-root"
if command -v dpkg-deb >/dev/null 2>&1; then
  stage_common "$deb_root"
  mkdir -p "$deb_root/DEBIAN"
  cat > "$deb_root/DEBIAN/control" <<EOF
Package: $NAME
Version: $VERSION-$REVISION
Section: devel
Priority: optional
Architecture: amd64
Depends: libgtk-3-0, libnotify4, libnss3, xdg-utils, libatspi2.0-0, libdrm2, libgbm1, libxcb-dri3-0, libasound2, libcups2, libdbus-1-3, libx11-6, libx11-xcb1, libxcb1, libxcomposite1, libxdamage1, libxext6, libxfixes3, libxkbcommon0, libxrandr2, mesa-vulkan-drivers | vulkan-icd, nodejs, curl, jq, gh, desktop-file-utils
Suggests: python3-pyside6.qtwidgets, python3-pyside6.qtnetwork, python3-websockets (>= 15), kde-spectacle, tesseract-ocr, tesseract-ocr-eng, tesseract-ocr-spa, zbar-tools
Maintainer: unofficial automation
Provides: codex-ui-linux-port
Conflicts: codex-ui-linux-port
Replaces: codex-ui-linux-port
Description: Codex I+D Lab - Unofficial
 Unofficial Linux packaging automation for the official ChatGPT runtime.
EOF
  dpkg-deb --root-owner-group --build "$deb_root" "$DIST/${NAME}_${VERSION}-${REVISION}_amd64.deb" >/dev/null
  rm -rf "$deb_root"
else
  echo "build-packages: dpkg-deb not found; deb package skipped" >&2
fi

rpm_root="$DIST/rpm-root"
if command -v rpmbuild >/dev/null 2>&1; then
  stage_common "$rpm_root"
  tar --owner=0 --group=0 -C "$rpm_root" -cf "$DIST/${NAME}-${VERSION}-${REVISION}-payload.tar" .
  rm -rf "$rpm_root"
  cat > "$DIST/${NAME}.spec" <<EOF
%global __os_install_post %{nil}
Name: $NAME
Version: $VERSION
Release: $REVISION
Summary: Codex I+D Lab - Unofficial
License: Custom
BuildArch: x86_64
Provides: codex-ui-linux-port
Obsoletes: codex-ui-linux-port
Requires: nodejs
Requires: curl
Requires: jq
Requires: gh
Requires: desktop-file-utils
Requires: alsa-lib
Requires: at-spi2-core
Requires: cairo
Requires: cups-libs
Requires: dbus-libs
Requires: expat
Requires: gtk3
Requires: libdrm
Requires: libnotify
Requires: libusb1
Requires: libX11
Requires: libxcb
Requires: libXcomposite
Requires: libXdamage
Requires: libXext
Requires: libXfixes
Requires: libxkbcommon
Requires: libXrandr
Requires: mesa-libgbm
Requires: nspr
Requires: nss
Requires: pango
Requires: xdg-utils
Suggests: python3-pyside6
Suggests: python3-websockets >= 15
Suggests: spectacle
Suggests: tesseract
Suggests: tesseract-langpack-eng
Suggests: tesseract-langpack-spa
Suggests: zbar

%description
Unofficial packaging automation for the official ChatGPT Linux runtime.

%prep

%build

%install
mkdir -p %{buildroot}
tar -xf %{_sourcedir}/${NAME}-${VERSION}-${REVISION}-payload.tar -C %{buildroot}

%files
/opt/codex-id-lab-unofficial
/usr/bin/codex-lab
/usr/bin/codex-lab-install
/usr/bin/codex-lab-update
/usr/bin/codex-lab-tools
/usr/lib/systemd/user/codex-lab-companion.service
/usr/share/applications/codex-lab.desktop
/usr/share/applications/codex-lab-tools.desktop
/usr/share/icons/hicolor/scalable/apps/codex-lab.svg
/usr/share/licenses/codex-id-lab-unofficial
EOF

  rpmbuild --define "_topdir $DIST/rpmbuild" \
    --define "_sourcedir $DIST" \
    --define "_rpmdir $DIST" \
    --define "_binary_payload w7T0.zstdio" \
    -bb "$DIST/${NAME}.spec" >/dev/null
  built_rpm="$(find "$DIST/$ARCH" -name '*.rpm' -type f -print -quit)"
  [[ -n "$built_rpm" ]] || { echo "build-packages: RPM output not found" >&2; exit 1; }
  cp "$built_rpm" "$DIST/${NAME}-${VERSION}-${REVISION}.x86_64.rpm"
else
  echo "build-packages: rpmbuild not found; rpm package skipped" >&2
fi

rm -rf "$DIST/arch-root" "$DIST/deb-root" "$DIST/rpm-root" "$DIST/rpmbuild" "$DIST/x86_64"
rm -f "$DIST/.PKGINFO" "$DIST/${NAME}.spec" "$DIST/${NAME}-${VERSION}-${REVISION}-payload.tar"
