#!/usr/bin/env bash
set -euo pipefail

INSTALL_ROOT="${1:?install root required}"
VERSION="${2:?version required}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[[ -x "$INSTALL_ROOT/ChatGPT" && -x "$INSTALL_ROOT/resources/codex" ]] || {
  echo "install-linux-integration: incomplete official runtime" >&2
  exit 1
}

mkdir -p "$INSTALL_ROOT/bin" "$INSTALL_ROOT/share/icons/hicolor/scalable/apps" "$INSTALL_ROOT/share/systemd/user"
install -m 644 "$SCRIPT_DIR/discord-rich-presence.js" "$INSTALL_ROOT/share/discord-rich-presence.js"
install -m 755 "$SCRIPT_DIR/codex-lab-companion.py" "$INSTALL_ROOT/share/codex-lab-companion.py"
install -m 644 "$SCRIPT_DIR/../resources/codex-lab-tools.desktop" "$INSTALL_ROOT/share/codex-lab-tools.desktop"
install -m 644 "$SCRIPT_DIR/../resources/codex-lab-companion.service" "$INSTALL_ROOT/share/systemd/user/codex-lab-companion.service"

cat > "$INSTALL_ROOT/bin/codex-cli-wrapper" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

bundled="/opt/codex-id-lab-unofficial/resources/codex"
if [[ -x "$bundled" ]]; then
  exec "$bundled" "$@"
fi
if command -v codex >/dev/null 2>&1; then
  exec codex "$@"
fi
echo "codex-cli-wrapper: Codex CLI is not available" >&2
exit 127
EOF

cat > "$INSTALL_ROOT/bin/codex-lab" <<EOF
#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="/opt/codex-id-lab-unofficial"
RUNTIME="\$APP_ROOT/ChatGPT"

# Do not leak a parent Codex CLI session into the desktop runtime.
unset CODEX_CI CODEX_SESSION_ID CODEX_THREAD_ID CODEX_MANAGED_BY_NPM
unset CODEX_MANAGED_PACKAGE_ROOT CODEX_SHELL CODEX_INTERNAL_ORIGINATOR_OVERRIDE

if [[ "\${1:-}" == "--version" ]]; then
  echo "codex-lab $VERSION"
  exit 0
fi

runtime_args=()
locale_value="\${CODEX_LAB_LANG:-\${CODEXUI_LANG:-\${LC_ALL:-\${LC_MESSAGES:-\${LANG:-}}}}}"
locale_value="\${locale_value%%.*}"
locale_value="\${locale_value%%@*}"
locale_value="\${locale_value//_/-}"
if [[ -n "\$locale_value" && "\$locale_value" != "C" && "\$locale_value" != "POSIX" ]]; then
  runtime_args+=(--lang="\$locale_value")
fi
ozone_platform="\${CODEX_LAB_OZONE_PLATFORM:-\${CODEXUI_OZONE_PLATFORM:-}}"
if [[ -n "\$ozone_platform" ]]; then
  runtime_args+=(--ozone-platform="\$ozone_platform")
  if [[ "\$ozone_platform" == "wayland" ]]; then
    runtime_args+=(--enable-features=GlobalShortcutsPortal)
  fi
fi
electron_flags="\${CODEX_LAB_ELECTRON_FLAGS:-\${CODEXUI_ELECTRON_FLAGS:-}}"
if [[ -n "\$electron_flags" ]]; then
  read -r -a configured_flags <<< "\$electron_flags"
  runtime_args+=("\${configured_flags[@]}")
fi

config_home="\${XDG_CONFIG_HOME:-\$HOME/.config}"
discord_config="\$config_home/codex-id-lab-unofficial/discord-rich-presence.json"
if [[ ! -f "\$discord_config" && -f "\$config_home/codex-ui-linux-port/discord-rich-presence.json" ]]; then
  discord_config="\$config_home/codex-ui-linux-port/discord-rich-presence.json"
fi
if [[ -f "\$discord_config" ]]; then
  if [[ "\${CODEX_LAB_DISCORD_RPC_DEBUG:-\${CODEXUI_DISCORD_RPC_DEBUG:-0}}" == "1" ]]; then
    /usr/bin/node "\$APP_ROOT/share/discord-rich-presence.js" "\$discord_config" &
  else
    /usr/bin/node "\$APP_ROOT/share/discord-rich-presence.js" "\$discord_config" >/dev/null 2>&1 &
  fi
fi

exec "\$RUNTIME" "\${runtime_args[@]}" "\$@"
EOF

cat > "$INSTALL_ROOT/bin/codex-lab-tools" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

export CODEX_LAB_CODEX_COMMAND="${CODEX_LAB_CODEX_COMMAND:-${CODEXUI_CODEX_COMMAND:-/opt/codex-id-lab-unofficial/bin/codex-cli-wrapper}}"
export CODEXUI_CODEX_COMMAND="$CODEX_LAB_CODEX_COMMAND"
exec /usr/bin/python3 /opt/codex-id-lab-unofficial/share/codex-lab-companion.py "$@"
EOF

chmod 755 "$INSTALL_ROOT/bin/codex-cli-wrapper" "$INSTALL_ROOT/bin/codex-lab" "$INSTALL_ROOT/bin/codex-lab-tools"

cat > "$INSTALL_ROOT/share/codex-lab.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Codex I+D Lab - Unofficial
Name[es]=Codex I+D Lab - No oficial
Comment=Unofficial Linux package using the official ChatGPT runtime
Comment[es]=Paquete Linux no oficial con el runtime oficial de ChatGPT
Exec=codex-lab %U
Icon=codex-lab
Terminal=false
Categories=Development;
StartupNotify=true
MimeType=x-scheme-handler/codex;
Actions=Usage;OCR;QR;Crashes;

[Desktop Action Usage]
Name=Codex usage
Name[es]=Uso de Codex
Exec=codex-lab-tools panel
Icon=view-statistics

[Desktop Action OCR]
Name=Capture text (OCR)
Name[es]=Capturar texto (OCR)
Exec=codex-lab-tools ocr
Icon=edit-select-text

[Desktop Action QR]
Name=Capture QR privately
Name[es]=Capturar QR de forma privada
Exec=codex-lab-tools qr
Icon=view-barcode-qr

[Desktop Action Crashes]
Name=Crash reports
Name[es]=Informes de fallos
Exec=codex-lab-tools crashes
Icon=tools-report-bug
EOF

cat > "$INSTALL_ROOT/share/icons/hicolor/scalable/apps/codex-lab.svg" <<'EOF'
<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <rect width="512" height="512" rx="96" fill="#111827"/>
  <path d="M256 72 414 164v184L256 440 98 348V164L256 72Z" fill="none" stroke="#67e8f9" stroke-width="34" stroke-linejoin="round"/>
  <path d="M256 144 352 200v112l-96 56-96-56V200l96-56Z" fill="none" stroke="#a7f3d0" stroke-width="28" stroke-linejoin="round"/>
  <circle cx="256" cy="256" r="38" fill="#67e8f9"/>
</svg>
EOF
