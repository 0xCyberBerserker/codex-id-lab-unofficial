#!/usr/bin/env bash
set -euo pipefail

INSTALL_ROOT="${1:?install root required}"
VERSION="${2:?version required}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_SRC="$INSTALL_ROOT/app-src"
BUILD_NUMBER="$(node -e 'const p=require(process.argv[1]); process.stdout.write(String(p["codexBuildNumber"] || ""))' "$APP_SRC/package.json")"

mkdir -p "$INSTALL_ROOT/bin" "$INSTALL_ROOT/share/icons/hicolor/scalable/apps" "$INSTALL_ROOT/share/systemd/user"
install -m 644 "$SCRIPT_DIR/discord-rich-presence.js" "$INSTALL_ROOT/share/discord-rich-presence.js"
install -m 755 "$SCRIPT_DIR/codex-ui-companion.py" "$INSTALL_ROOT/share/codex-ui-companion.py"
install -m 644 "$SCRIPT_DIR/../resources/codex-ui-tools.desktop" "$INSTALL_ROOT/share/codex-ui-tools.desktop"
install -m 644 "$SCRIPT_DIR/../resources/codex-ui-companion.service" "$INSTALL_ROOT/share/systemd/user/codex-ui-companion.service"

cat > "$INSTALL_ROOT/bin/codex-cli-wrapper" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

candidate_versions=()
for root in "$HOME/.local/lib/node_modules/@openai/codex" "$HOME/.local/share/pnpm/global" "/usr/lib/node_modules/@openai/codex"; do
  if [[ -d "$root" && -f "$root/bin/codex.js" ]]; then
    version="$(node -p "require(process.argv[1]).version" "$root/package.json" 2>/dev/null || true)"
    [[ -n "$version" ]] && candidate_versions+=("$version	$root")
  elif [[ -d "$root" ]]; then
    while IFS= read -r found; do
      version="$(node -p "require(process.argv[1]).version" "$found/package.json" 2>/dev/null || true)"
      [[ -n "$version" ]] && candidate_versions+=("$version	$found")
    done < <(find "$root" -type f -path '*/node_modules/@openai/codex/bin/codex.js' -printf '%h/..\n' 2>/dev/null)
  fi
done

if [[ "${#candidate_versions[@]}" -eq 0 ]]; then
  echo "codex-cli-wrapper: @openai/codex is not installed" >&2
  exit 127
fi

selected="$(printf '%s\n' "${candidate_versions[@]}" | sort -V -k1,1 | tail -n 1 | cut -f2-)"
exec /usr/bin/node "$selected/bin/codex.js" "$@"
EOF

cat > "$INSTALL_ROOT/bin/codex-ui-linux" <<EOF
#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="/opt/codex-ui-linux-port"
ELECTRON_BIN="\${ELECTRON_BIN:-electron42}"
CLI_WRAPPER="\$APP_ROOT/bin/codex-cli-wrapper"

if [[ "\${1:-}" == "--version" ]]; then
  echo "codex-ui-linux $VERSION"
  exit 0
fi

export BUILD_FLAVOR=prod
export CODEX_BUILD_NUMBER="\${CODEX_BUILD_NUMBER:-$BUILD_NUMBER}"
export CODEX_CLI_PATH="\$CLI_WRAPPER"

locale_value="\${CODEXUI_LANG:-\${LC_ALL:-\${LC_MESSAGES:-\${LANG:-}}}}"
locale_value="\${locale_value%%.*}"
locale_value="\${locale_value%%@*}"
locale_value="\${locale_value//_/-}"

electron_args=()
if [[ "\${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
  electron_args+=(--enable-features=GlobalShortcutsPortal)
fi
if [[ -n "\$locale_value" && "\$locale_value" != "C" && "\$locale_value" != "POSIX" ]]; then
  electron_args+=(--lang="\$locale_value")
fi
if [[ -n "\${CODEXUI_OZONE_PLATFORM:-}" ]]; then
  electron_args+=(--ozone-platform="\$CODEXUI_OZONE_PLATFORM")
fi
if [[ -n "\${CODEXUI_ELECTRON_FLAGS:-}" ]]; then
  read -r -a configured_flags <<< "\$CODEXUI_ELECTRON_FLAGS"
  electron_args+=("\${configured_flags[@]}")
fi

discord_config="\${XDG_CONFIG_HOME:-\$HOME/.config}/codex-ui-linux-port/discord-rich-presence.json"
if [[ -f "\$discord_config" ]]; then
  if [[ "\${CODEXUI_DISCORD_RPC_DEBUG:-0}" == "1" ]]; then
    /usr/bin/node "\$APP_ROOT/share/discord-rich-presence.js" "\$discord_config" &
  else
    /usr/bin/node "\$APP_ROOT/share/discord-rich-presence.js" "\$discord_config" >/dev/null 2>&1 &
  fi
fi

exec "\$ELECTRON_BIN" "\${electron_args[@]}" "\$APP_ROOT/app-src" "\$@"
EOF

cat > "$INSTALL_ROOT/bin/codex-ui-linux-paste" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]] && command -v ydotool >/dev/null 2>&1; then
  exec ydotool key 29:1 47:1 47:0 29:0
fi
if command -v xdotool >/dev/null 2>&1; then
  exec xdotool key --clearmodifiers ctrl+v
fi
if command -v ydotool >/dev/null 2>&1; then
  exec ydotool key 29:1 47:1 47:0 29:0
fi

echo "codex-ui-linux-paste: install ydotool (Wayland) or xdotool (X11)" >&2
exit 127
EOF

cat > "$INSTALL_ROOT/bin/codex-ui-tools" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

export CODEXUI_CODEX_COMMAND="${CODEXUI_CODEX_COMMAND:-/opt/codex-ui-linux-port/bin/codex-cli-wrapper}"
exec /usr/bin/python3 /opt/codex-ui-linux-port/share/codex-ui-companion.py "$@"
EOF

chmod 755 "$INSTALL_ROOT/bin/codex-cli-wrapper" "$INSTALL_ROOT/bin/codex-ui-linux" "$INSTALL_ROOT/bin/codex-ui-linux-paste" "$INSTALL_ROOT/bin/codex-ui-tools"

node - "$APP_SRC/package.json" <<'NODE'
const fs = require("fs");
const file = process.argv[2];
const json = JSON.parse(fs.readFileSync(file, "utf8"));
json.desktopName = "codex-ui-linux.desktop";
fs.writeFileSync(file, `${JSON.stringify(json, null, 2)}\n`, "utf8");
NODE

bootstrap_files=("$APP_SRC"/.vite/build/bootstrap.js "$APP_SRC"/.vite/build/bootstrap-*.js)
for bootstrap_file in "${bootstrap_files[@]}"; do
  [[ -f "$bootstrap_file" ]] || continue
  node - "$bootstrap_file" <<'NODE'
const fs = require("fs");
const file = process.argv[2];
let text = fs.readFileSync(file, "utf8");
const owlShellGuard = /if\(process\.versions\.electron!=null&&typeof ([A-Za-z_$][\w$]*)\.app\.showTaskManager!=`function`\)throw Error\(`Codex requires the Owl app shell; stock Electron is no longer supported\.`\);/;
if (text.includes("Codex requires the Owl app shell") && owlShellGuard.test(text)) {
  text = text.replace(owlShellGuard, "if(process.versions.electron!=null&&typeof $1.app.showTaskManager!=`function`)$1.app.showTaskManager=()=>{};");
}
const stockElectronShim = /if\(process\.versions\.electron!=null&&typeof ([A-Za-z_$][\w$]*)\.app\.showTaskManager!=`function`\)\1\.app\.showTaskManager=\(\)=>\{\};/;
const shimMatch = text.match(stockElectronShim);
if (shimMatch) {
  const electron = shimMatch[1];
  const shims = [
    `${electron}.app.setDebugChromePagesEnabled??=()=>{};`,
    `${electron}.app.setRuntimeFeatures??=()=>{};`,
    `${electron}.BrowserWindow.isInputShapeSupported??=()=>false;`,
    `${electron}.BrowserWindow.isSystemBackdropSupported??=()=>false;`,
  ].filter((shim) => !text.includes(shim)).join("");
  text = text.replace(stockElectronShim, `$&${shims}`);
  fs.writeFileSync(file, text, "utf8");
}
const before = "let i=require(`electron`),a=require(`node:path`);";
const bridgeMarker = "codexui-linux-control-bridge";
const bridgeV2 = String.raw`try{
globalThis.__codexUiLinuxControlBridge="codexui-linux-control-bridge";
(()=>{
const fs=require("node:fs"),net=require("node:net"),path=require("node:path"),os=require("node:os");
function visibleWindow(){
  const focused=i.BrowserWindow.getFocusedWindow();
  if(focused&&!focused.isDestroyed()&&focused.isVisible())return focused;
  return i.BrowserWindow.getAllWindows().find(w=>!w.isDestroyed()&&w.isVisible());
}
function showWindow(win){
  if(!win)throw Error("no visible Codex window");
  if(win.isMinimized())win.restore();
  win.show();
  win.focus();
}
async function startDictation(win){
  showWindow(win);
  await win.webContents.executeJavaScript("(()=>{const opts={key:\"D\",code:\"KeyD\",ctrlKey:true,shiftKey:true,bubbles:true,cancelable:true,composed:true};const targets=[window,document,document.activeElement].filter(Boolean);for(const target of targets){try{target.dispatchEvent(new KeyboardEvent(\"keydown\",opts))}catch{}}setTimeout(()=>{for(const target of targets){try{target.dispatchEvent(new KeyboardEvent(\"keyup\",opts))}catch{}}},80);})()",true);
  return {ok:true};
}
function promptScript(prompt,submit){
  return "(async()=>{const text="+JSON.stringify(String(prompt||""))+";const submit="+(submit===false?"false":"true")+";function visible(el){if(!el||!el.getBoundingClientRect)return false;const r=el.getBoundingClientRect();const s=getComputedStyle(el);return r.width>0&&r.height>0&&s.visibility!==\"hidden\"&&s.display!==\"none\";}function box(el){if(!visible(el))return false;const tag=(el.tagName||\"\").toLowerCase();return tag===\"textarea\"||tag===\"input\"||el.isContentEditable||el.getAttribute(\"contenteditable\")===\"true\"||el.getAttribute(\"role\")===\"textbox\";}function pick(){const active=document.activeElement;if(box(active))return active;const all=Array.from(document.querySelectorAll(\"textarea,input[type=text],[contenteditable=true],[role=textbox]\")).filter(box);return all[all.length-1]||null;}function setText(el,value){el.focus();const tag=(el.tagName||\"\").toLowerCase();if(tag===\"textarea\"||tag===\"input\"){const proto=tag===\"textarea\"?HTMLTextAreaElement.prototype:HTMLInputElement.prototype;const setter=Object.getOwnPropertyDescriptor(proto,\"value\")?.set;if(setter)setter.call(el,value);else el.value=value;el.dispatchEvent(new InputEvent(\"input\",{bubbles:true,inputType:\"insertText\",data:value}));el.dispatchEvent(new Event(\"change\",{bubbles:true}));return;}try{document.execCommand(\"selectAll\",false,null);document.execCommand(\"insertText\",false,value);}catch{el.textContent=value;}el.dispatchEvent(new InputEvent(\"input\",{bubbles:true,inputType:\"insertText\",data:value}));}function buttonLabel(b){return String((b.getAttribute(\"aria-label\")||\"\")+\" \"+(b.title||\"\")+\" \"+(b.textContent||\"\")).toLowerCase();}const el=pick();if(!el)throw Error(\"no prompt field found\");setText(el,text);await new Promise(r=>setTimeout(r,180));if(submit){const buttons=Array.from(document.querySelectorAll(\"button\")).filter(visible).reverse();const send=buttons.find(b=>!b.disabled&&/(send|enviar|submit)/.test(buttonLabel(b)));if(send){send.click();return {inserted:true,submitted:\"button\"};}const opts={key:\"Enter\",code:\"Enter\",bubbles:true,cancelable:true,composed:true};el.dispatchEvent(new KeyboardEvent(\"keydown\",opts));el.dispatchEvent(new KeyboardEvent(\"keyup\",opts));return {inserted:true,submitted:\"enter\"};}return {inserted:true,submitted:false};})()";
}
async function submitPrompt(win,payload){
  showWindow(win);
  const prompt=String(payload.prompt||"").trim();
  if(!prompt)throw Error("empty prompt");
  const result=await win.webContents.executeJavaScript(promptScript(prompt,payload.submit),true);
  return {ok:true,result};
}
function readScript(mode){
  return "(async()=>{const mode="+JSON.stringify(String(mode||"selection"))+";function visible(el){if(!el||!el.getBoundingClientRect)return false;const r=el.getBoundingClientRect();const s=getComputedStyle(el);return r.width>0&&r.height>0&&s.visibility!==\"hidden\"&&s.display!==\"none\";}function clean(s){return String(s||\"\").replace(/\\s+/g,\" \").trim();}if(mode===\"selection\"){const selected=clean(window.getSelection&&window.getSelection().toString());if(selected)return {text:selected,source:\"selection\"};}const nodes=Array.from(document.querySelectorAll(\"main article,[data-message-author-role],.markdown,main,[role=main]\")).filter(visible);const texts=nodes.map(n=>clean(n.innerText||n.textContent)).filter(Boolean);if(mode===\"last-response\"){for(let i=texts.length-1;i>=0;i--){const text=texts[i];if(text.length>40)return {text,source:\"last-response\"};}if(texts.length)return {text:texts[texts.length-1],source:\"last-visible\"};}const body=clean((document.body&&document.body.innerText)||\"\");return {text:body,source:\"visible\"};})()";
}
async function readText(win,payload){
  showWindow(win);
  const result=await win.webContents.executeJavaScript(readScript(payload.mode),true);
  const text=String(result&&result.text||"").trim();
  if(!text)throw Error("no readable text found");
  return {ok:true,text,source:String(result&&result.source||"unknown")};
}
function handle(payload){
  const win=visibleWindow();
  if(payload.command==="start-dictation")return startDictation(win);
  if(payload.command==="submit-prompt")return submitPrompt(win,payload);
  if(payload.command==="read-text")return readText(win,payload);
  throw Error("unsupported command");
}
function setup(){
  const runtime=process.env.XDG_RUNTIME_DIR||path.join(os.tmpdir(),"codex-ui-"+(process.getuid?.()??"user"));
  const dir=path.join(runtime,"codex-ui-linux-port");
  fs.mkdirSync(dir,{recursive:true,mode:0o700});
  const sock=path.join(dir,"control.sock");
  try{if(fs.existsSync(sock))fs.unlinkSync(sock)}catch{}
  const server=net.createServer(conn=>{
    let buffer="";
    conn.setEncoding("utf8");
    conn.on("data",chunk=>{
      buffer+=chunk;
      if(!buffer.includes("\n"))return;
      const line=buffer.trim();
      buffer="";
      Promise.resolve().then(()=>{let payload;try{payload=JSON.parse(line)}catch{payload={command:line}}return handle(payload)}).then(result=>{conn.write(JSON.stringify(result)+"\n");conn.end()}).catch(err=>{conn.write(JSON.stringify({ok:false,error:String(err?.message||err)})+"\n");conn.end()});
    });
  });
  server.listen(sock,()=>{try{fs.chmodSync(sock,0o600)}catch{}});
}
i.app.whenReady().then(setup).catch(()=>{});
})();
}catch{}`;
const menuPatch = "try{i.Menu.setApplicationMenu(null),i.app.on(`browser-window-created`,(e,t)=>{try{t.setMenuBarVisibility(!1),t.removeMenu?.()}catch{}})}catch{}";
const electronRequire = "let i=require(`electron`);";
const menuPatchStart = "try{i.Menu.setApplicationMenu";
if (text.includes(bridgeMarker) && text.includes(menuPatchStart) && (!text.includes("submit-prompt") || !text.includes("read-text"))) {
  const start = text.indexOf(electronRequire);
  const bridgeStart = start === -1 ? -1 : start + electronRequire.length;
  const bridgeEnd = text.indexOf(menuPatchStart, bridgeStart);
  if (bridgeStart !== -1 && bridgeEnd > bridgeStart) {
    text = text.slice(0, bridgeStart) + bridgeV2 + text.slice(bridgeEnd);
    fs.writeFileSync(file, text, "utf8");
  }
}
if (text.includes(before)) {
  const after = `let i=require(\`electron\`);${bridgeV2}${menuPatch}let a=require(\`node:path\`);`;
  if (!text.includes(bridgeMarker) || !text.includes("Menu.setApplicationMenu(null)")) {
    text = text.replace(before, after);
    fs.writeFileSync(file, text, "utf8");
  }
} else {
  if (!text.includes(bridgeMarker)) {
    text = text.replace("let i=require(`electron`);", `let i=require(\`electron\`);${bridgeV2}`);
  }
  if (!text.includes("Menu.setApplicationMenu(null)")) {
    text = text.replace("let i=require(`electron`);", `let i=require(\`electron\`);${menuPatch}`);
  }
  fs.writeFileSync(file, text, "utf8");
}
NODE
done

main_files=("$APP_SRC"/.vite/build/main.js "$APP_SRC"/.vite/build/main-*.js)
for main_file in "${main_files[@]}"; do
  [[ -f "$main_file" ]] || continue
  node - "$main_file" <<'NODE'
const fs = require("fs");
const file = process.argv[2];
let text = fs.readFileSync(file, "utf8");
const audioPermissionMarker = "__codexUiLinuxAudioPermission";
const globalDictationMarker = "__codexUiLinuxGlobalDictation";
const exposesVoice = text.includes("/codex/dictation-stream-connect-info") || text.includes("realtime-voice-host-coordinator");
if (exposesVoice && !text.includes(audioPermissionMarker)) {
  const restrictiveAppSession = /([A-Za-z_$][\w$]*)\.setPermissionRequestHandler\(\(([A-Za-z_$][\w$]*),([A-Za-z_$][\w$]*),([A-Za-z_$][\w$]*)\)=>\{\4\(\3===`clipboard-sanitized-write`\)\}\),\1\.setPermissionCheckHandler\(\(([A-Za-z_$][\w$]*),([A-Za-z_$][\w$]*)\)=>\6===`clipboard-sanitized-write`\)/;
  const match = text.match(restrictiveAppSession);
  if (!match) {
    throw new Error(`unrecognized app-session permission handler in ${file}`);
  }
  const [original, session, requestWebContents, requestPermission, callback, checkWebContents, checkPermission] = match;
  const replacement = `globalThis.${audioPermissionMarker}="audio-only",${session}.setPermissionRequestHandler((${requestWebContents},${requestPermission},${callback},codexUiDetails)=>{${callback}(${requestPermission}===\`clipboard-sanitized-write\`||${requestPermission}===\`media\`&&codexUiDetails?.mediaTypes?.length===1&&codexUiDetails.mediaTypes[0]===\`audio\`)}),${session}.setPermissionCheckHandler((${checkWebContents},${checkPermission},codexUiOrigin,codexUiDetails)=>${checkPermission}===\`clipboard-sanitized-write\`||${checkPermission}===\`media\`&&codexUiDetails?.mediaType===\`audio\`)`;
  text = text.replace(original, replacement);
}
if (exposesVoice && !text.includes(globalDictationMarker)) {
  const platformGate = /function ([A-Za-z_$][\w$]*)\(\)\{return process\.platform===`darwin`\|\|process\.platform===`win32`\}/;
  const platformGateMatch = text.match(platformGate);
  if (!platformGateMatch) {
    throw new Error(`unrecognized global dictation platform gate in ${file}`);
  }
  const platformGateName = platformGateMatch[1];
  text = text.replace(
    platformGate,
    `globalThis.${globalDictationMarker}="toggle-only";function ${platformGateName}(){return process.platform===\`darwin\`||process.platform===\`win32\`||process.platform===\`linux\`}`,
  );

  const escapedPlatformGateName = platformGateName.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const holdSetter = new RegExp(`setHotkeyForMode\\(([A-Za-z_$][\\w$]*),([A-Za-z_$][\\w$]*)\\)\\{if\\(!${escapedPlatformGateName}\\(\\)\\|\\|!this\\.isGateEnabled\\)return this\\.createMutationFailure\\(\\\`Not supported\\.\\\`\\);`);
  const holdSetterMatch = text.match(holdSetter);
  if (!holdSetterMatch) {
    throw new Error(`unrecognized global dictation hotkey setter in ${file}`);
  }
  const [, modeArgument, hotkeyArgument] = holdSetterMatch;
  text = text.replace(
    holdSetter,
    `setHotkeyForMode(${modeArgument},${hotkeyArgument}){if(process.platform===\`linux\`&&${modeArgument}===\`hold\`&&${hotkeyArgument}!=null)return this.createMutationFailure(\`Hold-to-dictate is not supported on Linux. Use the toggle shortcut.\`);if(!${platformGateName}()||!this.isGateEnabled)return this.createMutationFailure(\`Not supported.\`);`,
  );

  const holdRegistration = "this.configuredHotkey==null?this.unregisterHotkey():this.registerHotkeyOrThrow(this.configuredHotkey,e)";
  if (!text.includes(holdRegistration)) {
    throw new Error(`unrecognized global dictation hold registration in ${file}`);
  }
  text = text.replace(
    holdRegistration,
    "process.platform===`linux`||this.configuredHotkey==null?this.unregisterHotkey():this.registerHotkeyOrThrow(this.configuredHotkey,e)",
  );

  const pasteFunctionStart = text.indexOf("async function RIe(){switch(process.platform)");
  const pasteFunctionEnd = pasteFunctionStart === -1 ? -1 : text.indexOf("}}", pasteFunctionStart) + 2;
  if (pasteFunctionStart === -1 || pasteFunctionEnd <= pasteFunctionStart) {
    throw new Error(`unrecognized global dictation paste function in ${file}`);
  }
  const pasteFunction = text.slice(pasteFunctionStart, pasteFunctionEnd);
  const unsupportedLinux = "case`aix`:case`android`:case`cygwin`:case`freebsd`:case`haiku`:case`linux`:case`netbsd`:case`openbsd`:case`sunos`:throw Error(`Global dictation paste is not supported on this OS.`)";
  if (!pasteFunction.includes(unsupportedLinux)) {
    throw new Error(`unrecognized global dictation Linux paste branch in ${file}`);
  }
  const patchedPasteFunction = pasteFunction.replace(
    unsupportedLinux,
    "case`linux`:await z7(`/opt/codex-ui-linux-port/bin/codex-ui-linux-paste`,[]);return;case`aix`:case`android`:case`cygwin`:case`freebsd`:case`haiku`:case`netbsd`:case`openbsd`:case`sunos`:throw Error(`Global dictation paste is not supported on this OS.`)",
  );
  text = text.slice(0, pasteFunctionStart) + patchedPasteFunction + text.slice(pasteFunctionEnd);
}
if (text.includes(".setPreferredLanguages(") && !text.includes(".setPreferredLanguages?.(")) {
  text = text.replaceAll(".setPreferredLanguages(", ".setPreferredLanguages?.(");
}
fs.writeFileSync(file, text, "utf8");
NODE
done

voice_settings_assets=("$APP_SRC"/webview/assets/voice-settings-*.js)
for voice_settings_asset in "${voice_settings_assets[@]}"; do
  [[ -f "$voice_settings_asset" ]] || continue
  node - "$voice_settings_asset" <<'NODE'
const fs = require("fs");
const file = process.argv[2];
let text = fs.readFileSync(file, "utf8");
const holdAndToggle = /children:\[\(0,([A-Za-z_$][\w$]*)\.jsx\)\(([A-Za-z_$][\w$]*),\{hotkeyState:([A-Za-z_$][\w$]*),mode:`hold`\}\),\(0,\1\.jsx\)\(\2,\{hotkeyState:\3,mode:`toggle`\}\)\]/;
const holdAndToggleMatch = text.match(holdAndToggle);
if (holdAndToggleMatch) {
  const [, jsxNamespace, component, hotkeyState] = holdAndToggleMatch;
  text = text.replace(holdAndToggle, `children:[(0,${jsxNamespace}.jsx)(${component},{hotkeyState:${hotkeyState},mode:\`toggle\`})]`);
  fs.writeFileSync(file, text, "utf8");
} else if (!/children:\[\(0,[A-Za-z_$][\w$]*\.jsx\)\([A-Za-z_$][\w$]*,\{hotkeyState:[A-Za-z_$][\w$]*,mode:`toggle`\}\)\]/.test(text) && text.includes("settings.voice.dictation.unsupported")) {
  throw new Error(`unrecognized global dictation settings shape in ${file}`);
}
NODE
done

voice_assets=("$APP_SRC"/webview/assets/dictation-audio-worklet-*.js "$APP_SRC"/webview/assets/realtime-voice-*.js)
for voice_asset in "${voice_assets[@]}"; do
  [[ -f "$voice_asset" ]] || continue
  if ! grep -q "__codexUiLinuxAudioPermission" "${main_files[@]}" 2>/dev/null; then
    echo "apply-linux-patches: upstream voice support found without a recognized audio permission handler" >&2
    exit 1
  fi
  break
done

workspace_root_drop_handlers=("$APP_SRC"/.vite/build/workspace-root-drop-handler-*.js)
if [[ -f "${workspace_root_drop_handlers[0]:-}" ]]; then
  node - "${workspace_root_drop_handlers[@]}" <<'NODE'
const fs = require("fs");
const before = "function Qe(){let e=process._linkedBinding;if(typeof e!=`function`)throw Error(`Owl feature binding is unavailable`);return Ge.parse(e.call(process,`electron_common_owl_features`))}";
const after = "function Qe(){let e=process._linkedBinding;if(typeof e==`function`)try{return Ge.parse(e.call(process,`electron_common_owl_features`))}catch{}return Ge.parse({isOwlFeatureEnabled:e=>nt(rt(`enable-features`)).includes(e)&&!nt(rt(`disable-features`)).includes(e)})}";
for (const file of process.argv.slice(2)) {
  let text = fs.readFileSync(file, "utf8");
  if (text.includes("electron_common_owl_features`))}catch{}")) {
    continue;
  }
  if (text.includes(before)) {
    text = text.replace(before, after);
    fs.writeFileSync(file, text, "utf8");
    continue;
  }
  if (text.includes("Owl feature binding is unavailable")) {
    throw new Error(`unrecognized Owl feature binding shape in ${file}`);
  }
}
NODE
fi

shell_css="$(find "$APP_SRC/webview/assets" -maxdepth 1 -name 'app-shell-*.css' | head -n 1)"
if [[ -n "$shell_css" ]] && ! grep -q "Local Linux port visual override" "$shell_css"; then
  cat >> "$shell_css" <<'CSS'

/* Local Linux port visual override. */
:root[data-codex-window-type=electron]{
  --vscode-font-family:"Inter","OpenAI Sans","Segoe UI",system-ui,sans-serif;
