#!/usr/bin/env bash
set -euo pipefail

app="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
profile="${CODEX_HOME:?Set CODEX_HOME to an existing disposable profile}"
python3 "$app/share/native-pets/native_pets_first_launch.py" "$app" "$profile"
if [[ "${1:-}" == --prepare-only && $# -eq 1 ]]; then
  exit 0
fi
exec "$app/ChatGPT" "$@"
