#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cli="$(realpath "${1:?explicit verified native CLI required}")"
[[ -f "$cli" && -x "$cli" && ! -L "$1" ]] || exit 2
for prerequisite in bwrap node timeout; do
  command -v "$prerequisite" >/dev/null || { echo "shared-authority: NOT_RUN missing $prerequisite" >&2; exit 2; }
done
# No host account, home, desktop bus or model turn is used. Local runs also
# isolate the network namespace; hosted CI can opt into shared networking when
# the runner denies namespace creation.
SANDBOX_NAMESPACE_ARGS=(--unshare-all)
if [[ "${CODEX_LAB_CI_SHARED_NETWORK_FALLBACK:-0}" == 1 ]]; then
  # Hosted runners may reject bubblewrap's implicit user namespace too. The
  # workflow is disposable and credential-free, so run this Node test with a
  # clean environment instead; local runs keep the full bubblewrap sandbox.
  node_bin=$(command -v node)
  exec env -i PATH=/usr/bin HOME=/tmp/codex-lab-ci-home \
    CODEX_HOME=/tmp/codex-lab-ci-home/codex \
    CODEX_LAB_TEST_NATIVE_CLI="$cli" CODEX_LAB_TEST_NATIVE_ISOLATED=1 \
    timeout -k 5s 20s "$node_bin" --test "$repo/tests/shared-app-server.test.js"
fi
timeout -k 5s 20s bwrap "${SANDBOX_NAMESPACE_ARGS[@]}" --die-with-parent --new-session \
  --ro-bind / / --tmpfs /home --tmpfs /root --tmpfs /tmp --tmpfs /run \
  --dev /dev --proc /proc --ro-bind "$repo" /tmp/repo --ro-bind "$cli" /tmp/native-cli \
  --clearenv --setenv PATH /usr/bin --setenv HOME /tmp --setenv CODEX_HOME /tmp/codex \
  --setenv CODEX_LAB_TEST_NATIVE_CLI /tmp/native-cli --setenv CODEX_LAB_TEST_NATIVE_ISOLATED 1 \
  /usr/bin/node --test /tmp/repo/tests/shared-app-server.test.js
